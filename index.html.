const stations = [

{
t:"Wie gelangen Stoffe durch die Membran?",
c:"Grundlagen",
i:"Die Zellmembran grenzt das Zellinnere von der Umgebung ab. Sie ist selektiv permeabel: Manche Stoffe passieren sie leicht, andere benötigen Transportproteine.",
s:()=>base(`
<g fill="#f6bd60">
<circle cx="65" cy="65" r="5"/>
<circle cx="90" cy="80" r="5"/>
<circle cx="112" cy="60" r="5"/>
</g>
${arrow(90,82,90,166)}
${protein(245)}
${arrow(245,72,245,169,"#66a9ff")}
<text x="110" y="76" fill="#fff" font-size="10">Direkt</text>
<text x="267" y="88" fill="#fff" font-size="10">Protein</text>
`),
b:`
<h3>Drei grundlegende Wege</h3>

<div class="step">
<b>Einfache Diffusion:</b>
Kleine, unpolare Moleküle wie O₂ und CO₂
gelangen direkt durch die Lipiddoppelschicht.
</div>

<div class="step">
<b>Erleichterte Diffusion:</b>
Kanal- oder Carrierproteine helfen Stoffen,
die Membran zu passieren. Der Transport erfolgt
mit dem Gradienten und benötigt kein ATP.
</div>

<div class="step">
<b>Aktiver Transport:</b>
Stoffe werden gegen ihren Gradienten transportiert.
Dafür wird Energie benötigt.
</div>

<div class="callout">
<b>Merke:</b> Ein Transportprotein bedeutet
nicht automatisch aktiven Transport.
</div>
`
},

{
t:"Aufbau der Zellmembran",
c:"Membranstruktur",
i:"Die Membran besteht aus einer Phospholipid-Doppelschicht. Die Köpfe sind hydrophil, die Fettsäureschwänze hydrophob.",
s:()=>base(`
<rect x="110" y="91" width="140" height="66" rx="23"
fill="#438bd0" stroke="#8fc5ff" stroke-width="2"/>
<path d="M180 96 V152" stroke="#dceeff" stroke-width="3" stroke-dasharray="4 4"/>
<text x="180" y="211" fill="#d9eaf2" text-anchor="middle" font-size="11">
Membranprotein
</text>
`),
b:`
<h3>Phospholipide</h3>
<ul>
<li><b>Hydrophiler Kopf:</b> wasserliebend; zeigt zum Außenraum und zum Cytoplasma.</li>
<li><b>Hydrophobe Schwänze:</b> wassermeidend; liegen einander zugewandt im Inneren der Membran.</li>
</ul>

<h3>Warum ist die Membran selektiv?</h3>
<p>
Der hydrophobe Membrankern lässt kleine unpolare Moleküle
leichter passieren. Geladene Ionen und größere polare
Moleküle benötigen meist spezielle Transportproteine.
</p>
`
},

{
t:"Diffusion – entlang des Gradienten",
c:"Passiver Transport",
i:"Teilchen bewegen sich aufgrund ihrer Wärmebewegung zufällig. Bei einem Konzentrationsunterschied entsteht eine Nettobewegung von hoher zu niedriger Konzentration.",
s:()=>base(`
<g fill="#f6bd60">
${Array.from({length:13},(_,i)=>`
<circle cx="${35+(i%4)*23}"
cy="${53+Math.floor(i/4)*17}" r="5"/>
`).join('')}
</g>
${arrow(126,76,236,76)}
<text x="72" y="37" fill="#fff" text-anchor="middle" font-size="10">Hohe Konzentration</text>
<text x="276" y="37" fill="#fff" text-anchor="middle" font-size="10">Niedrige</text>
`),
b:`
<h3>Konzentrationsgradient</h3>
<p>
Ein Konzentrationsgradient ist ein Unterschied in der
Konzentration eines Stoffes zwischen zwei Bereichen.
Insgesamt wandern mehr Teilchen von hoher zu niedriger
Konzentration.
</p>

<h3>Gleichgewicht</h3>
<p>
Am Gleichgewicht bewegen sich Teilchen weiterhin.
Die Bewegungen in beide Richtungen gleichen sich
jedoch aus. Es gibt keinen Nettotransport mehr.
</p>

<div class="callout">
<b>Passiver Transport:</b>
Es wird keine zusätzliche Energie durch ATP benötigt.
</div>
`
},

{
t:"Kanalproteine – eine hydrophile Pore",
c:"Erleichterte Diffusion",
i:"Kanalproteine bilden einen selektiven, wassergefüllten Durchgang durch die Membran.",
s:()=>base(`
${protein(180)}
<rect x="174" y="101" width="12" height="48" rx="6" fill="#c8eaff"/>
<g fill="#f6bd60">
<circle cx="180" cy="60" r="6"/>
<circle cx="180" cy="78" r="6"/>
</g>
${arrow(180,85,180,172)}
<text x="208" y="119" fill="#fff" font-size="10">Pore</text>
`),
b:`
<h3>Ablauf</h3>
<ol>
<li>Ein passendes Teilchen befindet sich auf einer Membranseite.</li>
<li>Es gelangt in die hydrophile Pore.</li>
<li>Es diffundiert entlang seines elektrochemischen Gradienten auf die andere Seite.</li>
</ol>

<h3>Beispiele</h3>
<ul>
<li><b>Ionenkanäle:</b> transportieren bestimmte Ionen wie Na⁺, K⁺ oder Cl⁻.</li>
<li><b>Aquaporine:</b> ermöglichen den schnellen Transport von Wasser.</li>
</ul>

<div class="callout">
Ein Kanal pumpt nicht gegen den Gradienten.
Der Transport durch einen offenen Kanal ist passiv.
</div>
`
},

{
t:"Carrierproteine – Bindung und Formänderung",
c:"Erleichterte Diffusion",
i:"Ein Carrier bindet ein bestimmtes Molekül. Danach verändert das Protein seine Form und gibt das Molekül auf der anderen Seite frei.",
s:()=>base(`
<path d="M147 91 Q120 115 151 145 Q180 164 209 145 Q240 115 213 91 Q180 73 147 91Z"
fill="#438bd0" stroke="#8fc5ff" stroke-width="2"/>
<circle cx="180" cy="84" r="8" fill="#a78bfa"/>
${arrow(180,157,180,181,"#a78bfa")}
<text x="197" y="67" fill="#fff" font-size="10">Substrat</text>
`),
b:`
<h3>Der Carrier-Zyklus</h3>
<div class="step"><b>1. Bindung:</b> Das Molekül bindet an eine spezifische Stelle.</div>
<div class="step"><b>2. Formänderung:</b> Der Carrier verändert seine räumliche Struktur.</div>
<div class="step"><b>3. Freisetzung:</b> Das Molekül wird auf der anderen Seite abgegeben.</div>
<div class="step"><b>4. Rückkehr:</b> Der Carrier kehrt in seine Ausgangsform zurück.</div>

<p><b>Beispiel:</b> GLUT-Transporter schleusen Glucose durch erleichterte Diffusion in Zellen – entlang des Konzentrationsgradienten.</p>
`
},

{
t:"Uniport, Symport und Antiport",
c:"Transportformen",
i:"Diese Begriffe beschreiben, wie viele Stoffarten ein Transportprotein bewegt und in welche Richtung.",
s:()=>base(`
<g stroke="#438bd0" stroke-width="13" stroke-linecap="round">
<path d="M75 94 V154"/>
<path d="M180 94 V154"/>
<path d="M285 94 V154"/>
</g>
${arrow(75,69,75,173)}
${arrow(180,69,180,173)}
<path d="M198 173 V69" stroke="#a78bfa" stroke-width="3"/>
<path d="M192 77 L198 69 L204 77" fill="none" stroke="#a78bfa" stroke-width="3"/>
<text x="75" y="204" fill="#fff" text-anchor="middle" font-size="10">Uniport</text>
<text x="180" y="204" fill="#fff" text-anchor="middle" font-size="10">Symport</text>
<text x="285" y="204" fill="#fff" text-anchor="middle" font-size="10">Antiport</text>
`),
b:`
<h3>Die drei Transportformen</h3>
<ul>
<li><b>Uniport:</b> Eine Stoffart wird in eine Richtung transportiert.</li>
<li><b>Symport:</b> Zwei oder mehr Stoffarten werden gemeinsam in dieselbe Richtung transportiert.</li>
<li><b>Antiport:</b> Stoffe werden in entgegengesetzte Richtungen transportiert.</li>
</ul>

<div class="callout">
<b>Prüfungsfalle:</b>
Diese Begriffe sagen allein nicht, ob der Transport aktiv oder passiv ist.
</div>
`
},

{
t:"ATP – Energie für Zellprozesse",
c:"Energie",
i:"ATP bedeutet Adenosintriphosphat. Bei der Hydrolyse wird freie Energie verfügbar, die an energieverbrauchende Vorgänge gekoppelt werden kann.",
s:()=>`
<svg viewBox="0 0 360 240">
<text x="18" y="25" fill="#d9eaf2" font-size="13">ATP-Hydrolyse</text>
<rect x="20" y="65" width="95" height="55" rx="12" fill="#438bd0"/>
<text x="67" y="99" fill="white" text-anchor="middle" font-size="20">ATP</text>
<text x="130" y="98" fill="#fff" font-size="16">+ H₂O</text>
${arrow(210,93,248,93,"#f28bb7")}
<rect x="260" y="65" width="78" height="55" rx="12" fill="#a78bfa"/>
<text x="299" y="99" fill="white" text-anchor="middle" font-size="16">ADP</text>
<circle cx="299" cy="155" r="17" fill="#f6bd60"/>
<text x="299" y="159" fill="#17202a" text-anchor="middle" font-size="12">Pᵢ</text>
<text x="180" y="208" fill="#d9eaf2" text-anchor="middle" font-size="11">Freie Energie wird verfügbar</text>
</svg>
`,
b:`
<h3>Reaktionsgleichung</h3>
<div class="callout" style="text-align:center">
<b>ATP + H₂O → ADP + Pᵢ</b><br>
ATP + Wasser → ADP + anorganisches Phosphat
</div>

<h3>Wie wird Energie bereitgestellt?</h3>
<ol>
<li>ATP reagiert mit Wasser; eine Phosphatgruppe wird abgespalten.</li>
<li>Bei dieser Hydrolyse wird freie Energie verfügbar.</li>
<li>Die Zelle koppelt die Reaktion an einen energieverbrauchenden Vorgang.</li>
</ol>

<p>
Entscheidend ist die gesamte Hydrolysereaktion.
Nicht das bloße Brechen einer Bindung liefert Energie.
</p>
`
},

{
t:"Natrium-Kalium-Pumpe",
c:"Primär aktiver Transport",
i:"Die Natrium-Kalium-ATPase nutzt ATP direkt, um Na⁺ und K⁺ gegen ihre elektrochemischen Gradienten zu bewegen.",
s:()=>base(`
${protein(180)}
<g fill="#f6bd60">
<circle cx="155" cy="59" r="6"/>
<circle cx="180" cy="48" r="6"/>
<circle cx="205" cy="59" r="6"/>
</g>
<g fill="#55dfd2">
<circle cx="150" cy="178" r="6"/>
<circle cx="210" cy="178" r="6"/>
</g>
${arrow(180,83,180,48,"#f6bd60")}
${arrow(225,169,225,70,"#55dfd2")}
<text x="211" y="37" fill="#fff" font-size="11">3 Na⁺ hinaus</text>
<text x="240" y="145" fill="#fff" font-size="11">2 K⁺ hinein</text>
<text x="55" y="217" fill="#fff" font-size="11">1 ATP</text>
`),
b:`
<h3>Ein vollständiger Pumpzyklus</h3>
<div class="step"><b>1.</b> Drei Na⁺-Ionen binden an die Pumpe auf der Innenseite.</div>
<div class="step"><b>2.</b> ATP wird hydrolysiert. Eine Phosphatgruppe wird auf die Pumpe übertragen.</div>
<div class="step"><b>3.</b> Die Form der Pumpe ändert sich. Drei Na⁺ werden nach außen abgegeben.</div>
<div class="step"><b>4.</b> Zwei K⁺-Ionen binden von außen an die Pumpe.</div>
<div class="step"><b>5.</b> Die Phosphatgruppe wird abgespalten. Die Pumpe kehrt in ihre Ausgangsform zurück und gibt K⁺ nach innen ab.</div>

<h3>Bilanz pro ATP</h3>
<div class="callout">
<b>3 Na⁺ hinaus · 2 K⁺ hinein · 1 ATP verbraucht</b>
</div>

<p>
Die Pumpe hält die Na⁺-Konzentration innen niedrig
und die K⁺-Konzentration innen hoch.
</p>
`
},

{
t:"Sekundär aktiver Transport",
c:"Indirekte Energie",
i:"Ein Ionengradient, der zuvor durch eine ATP-verbrauchende Pumpe aufgebaut wurde, liefert die Energie für den Transport eines weiteren Stoffes.",
s:()=>base(`
${protein(180)}
<g fill="#f6bd60">
<circle cx="155" cy="54" r="6"/>
<circle cx="180" cy="43" r="6"/>
<circle cx="205" cy="54" r="6"/>
<circle cx="230" cy="68" r="6"/>
</g>
<circle cx="180" cy="83" r="8" fill="#a78bfa"/>
${arrow(180,88,180,174,"#f6bd60")}
<path d="M205 174 V75" stroke="#a78bfa" stroke-width="3"/>
<path d="M199 83 L205 75 L211 83" fill="none" stroke="#a78bfa" stroke-width="3"/>
<text x="20" y="202" fill="#fff" font-size="10">Na⁺ folgt seinem Gradienten</text>
<text x="20" y="217" fill="#fff" font-size="10">Glucose wird mittransportiert</text>
`),
b:`
<h3>Beispiel: Na⁺-Glucose-Symporter</h3>
<div class="step"><b>1. Gradient aufbauen:</b> Die Natrium-Kalium-Pumpe verbraucht ATP und hält die Na⁺-Konzentration außerhalb der Zelle hoch.</div>
<div class="step"><b>2. Natrium strömt zurück:</b> Na⁺ bewegt sich durch einen Symporter zurück in die Zelle – entlang seines elektrochemischen Gradienten.</div>
<div class="step"><b>3. Glucose wird mitgenommen:</b> Die Energie des Na⁺-Gradienten ermöglicht es, Glucose gleichzeitig gegen ihren Konzentrationsgradienten in die Zelle zu transportieren.</div>

<div class="callout">
<b>Warum sekundär?</b>
Der Symporter spaltet selbst kein ATP.
Die Energie stammt indirekt aus dem zuvor
durch ATP aufgebauten Ionengradienten.
</div>

<p>
<b>Merksatz:</b> Primär aktiv = ATP direkt.
Sekundär aktiv = Energie aus einem zuvor
aufgebauten Ionengradienten.
</p>
`
}
];

let current=0;

function render(){
  const s=stations[current];

  $("stationNo").textContent=
    `STATION ${String(current+1).padStart(2,"0")} / 09`;

  $("category").textContent=s.c;
  $("title").textContent=s.t;
  $("intro").textContent=s.i;
  $("diagram").innerHTML=s.s();
  $("content").innerHTML=s.b;

  $("prev").disabled=current===0;

  $("next").textContent=
    current===8 ? "Zur ersten Station ↺" : "Nächste Station →";

  document.querySelectorAll("#nav button").forEach((b,i)=>{
    b.classList.toggle("active",i===current);
  });
}

stations.forEach((s,i)=>{
  const b=document.createElement("button");
  b.innerHTML=`${String(i+1).padStart(2,"0")} · ${s.t}<small>${s.c}</small>`;
  b.onclick=()=>{current=i;render()};
  $("nav").append(b);
});

$("prev").onclick=()=>{
  current=Math.max(0,current-1);
  render();
};

$("next").onclick=()=>{
  current=(current+1)%stations.length;
  render();
};

/* QUIZ */

