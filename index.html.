
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CELL WORLD – Biologie Lernwelt</title>
<style>
:root {
  --bg:#071827;
  --panel:#10283b;
  --panel2:#15364b;
  --text:#eef7fb;
  --muted:#a9c1cf;
  --cyan:#55dfd2;
  --blue:#66a9ff;
  --gold:#f6bd60;
  --purple:#a78bfa;
  --pink:#f28bb7;
  --line:#2b4a60;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:radial-gradient(circle at 80% 0,#16445a 0,transparent 35%),var(--bg);
  color:var(--text);
  font:16px/1.55 system-ui,sans-serif;
}
button{font:inherit;cursor:pointer;color:inherit}
.wrap{max-width:1150px;margin:auto;padding:20px}
.hero{
  padding:36px 25px;
  border:1px solid var(--line);
  border-radius:24px;
  background:linear-gradient(120deg,#12364c,#145b61);
}
.eyebrow{
  text-transform:uppercase;
  letter-spacing:.18em;
  font-size:.75rem;
  color:#b8f6ee;
}
.hero h1{font-size:clamp(2.5rem,7vw,5rem);line-height:1;margin:12px 0}
.hero p{max-width:650px;color:#e0f5f5}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.chip{border:1px solid #ffffff44;border-radius:99px;padding:5px 11px;font-size:.8rem}
.layout{display:grid;grid-template-columns:250px 1fr;gap:18px;margin-top:20px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px}
.navlist{display:grid;gap:7px}
.nav button,.action,.answer{
  border:1px solid var(--line);
  background:#102d42;
  border-radius:11px;
  padding:10px 12px;
  text-align:left;
}
.nav button.active,.action.primary{background:#164c55;border-color:var(--cyan)}
.nav button small{display:block;color:var(--muted);font-size:.72rem}
.lesson h2{font-size:clamp(1.5rem,4vw,2.2rem)}
.meta{display:flex;justify-content:space-between;color:var(--muted);font-size:.82rem}
.lead{color:#c5d9e3}
.diagram{margin:18px 0;padding:10px;background:#091d2c;border:1px solid var(--line);border-radius:16px}
.diagram svg{width:100%;height:auto;display:block}
.legend{display:flex;flex-wrap:wrap;gap:14px;color:var(--muted);font-size:.8rem}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}
.content h3{font-size:1.08rem;margin:20px 0 7px}
.content p,.content li{color:#d4e3eb}
.step{background:#122f43;border-left:3px solid var(--cyan);border-radius:0 10px 10px 0;padding:10px 13px;margin:9px 0}
.callout{padding:13px;border:1px solid #46746f;background:#103b3c;border-radius:12px;margin:14px 0}
.controls{display:flex;gap:9px;margin-top:20px}
.controls button{flex:1}
.quiz{margin-top:20px}
.answer{display:block;width:100%;margin:8px 0}
.answer.correct{border-color:#58d69c;background:#123c35}
.answer.wrong{border-color:#f28b87;background:#472b32}
.muted{color:var(--muted)}
footer{text-align:center;color:var(--muted);font-size:.8rem;padding:25px}
@media(max-width:760px){
  .wrap{padding:12px}
  .layout{grid-template-columns:1fr}
  .navlist{grid-template-columns:repeat(2,minmax(0,1fr))}
  .nav button{font-size:.82rem}
}
</style>
</head>
<body>
<main class="wrap">

<header class="hero">
  <div class="eyebrow">Interaktive Biologie-Lernwelt</div>
  <h1>CELL WORLD</h1>
  <p>
    Reise durch die Zellmembran und entdecke, wie Stoffe
    die Zelle betreten und verlassen – von einfacher
    Diffusion bis zum energieabhängigen Transport.
  </p>
  <div class="chips">
    <span class="chip">9 Lernstationen</span>
    <span class="chip">Membranmodelle</span>
    <span class="chip">ATP & Energie</span>
    <span class="chip">Wissensquiz</span>
  </div>
</header>

<div class="layout">

<aside class="panel nav">
  <h2>Deine Lernreise</h2>
  <div class="navlist" id="nav"></div>
  <p class="muted">
    Arbeite die Stationen der Reihe nach durch.
    Du kannst jederzeit zurückspringen.
  </p>
</aside>

<section class="panel lesson">
  <div class="meta">
    <span id="stationNo">STATION 01 / 09</span>
    <span id="category">Grundlagen</span>
  </div>

  <h2 id="title"></h2>
  <p class="lead" id="intro"></p>

  <div class="diagram" id="diagram"></div>

  <div class="legend">
    <span><i class="dot" style="background:#f6bd60"></i>Na⁺ / Membran</span>
    <span><i class="dot" style="background:#66a9ff"></i>Transportprotein</span>
    <span><i class="dot" style="background:#a78bfa"></i>Glucose</span>
    <span><i class="dot" style="background:#55dfd2"></i>K⁺</span>
  </div>

  <article class="content" id="content"></article>

  <div class="controls">
    <button class="action" id="prev">← Zurück</button>
    <button class="action primary" id="next">Nächste Station →</button>
  </div>
</section>
</div>

<section class="panel quiz">
  <h2>Wissenscheck</h2>
  <p class="muted">
    Teste dein Wissen mit fünf Fragen.
  </p>
  <div id="quiz"></div>
</section>

<footer>
  CELL WORLD · Biologie Lernwelt<br>
  Schematische Darstellungen – nicht maßstabsgetreu.
</footer>

</main>

<script>
const $ = id => document.getElementById(id);

const membrane = `
<rect x="18" y="112" width="324" height="12" rx="6" fill="#a9793e"/>
<rect x="18" y="132" width="324" height="12" rx="6" fill="#a9793e"/>
${Array.from({length:14},(_,i)=>`
<circle cx="${27+i*23}" cy="118" r="6" fill="#f6d69d"/>
<circle cx="${27+i*23}" cy="138" r="6" fill="#f6d69d"/>
`).join('')}
`;

const base = inner => `
<svg viewBox="0 0 360 250">
<text x="18" y="23" fill="#d9eaf2" font-size="12">Außenraum</text>
${membrane}
${inner}
<text x="18" y="181" fill="#d9eaf2" font-size="12">Cytoplasma</text>
</svg>
`;

const protein = (x=180) => `
<path d="M${x-18} 92 Q${x-28} 104 ${x-18} 119
L${x-18} 143 Q${x} 162 ${x+18} 143
L${x+18} 119 Q${x+28} 104 ${x+18} 92
Q${x} 78 ${x-18} 92Z"
fill="#438bd0" stroke="#8fc5ff" stroke-width="2"/>
`;

const arrow = (x1,y1,x2,y2,c="#f6bd60") => `
<path d="M${x1} ${y1} L${x2} ${y2}"
stroke="${c}" stroke-width="3" fill="none"/>
<path d="M${x2-6} ${y2-8} L${x2} ${y2} L${x2+6} ${y2-8}"
