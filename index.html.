0,
"Die Energie stammt aus einem zuvor aufgebauten elektrochemischen Ionengradienten."
],
[
"Was bedeutet Antiport?",
["Zwei Stoffe in dieselbe Richtung","Ein Stoff in eine Richtung","Stoffe in entgegengesetzte Richtungen"],
2,
"Beim Antiport bewegen sich die transportierten Stoffe in entgegengesetzte Richtungen."
],
[
"Was geschieht am Diffusionsgleichgewicht?",
["Teilchen stehen still","Es gibt keinen Nettotransport","Alle Teilchen sind auf einer Seite"],
1,
"Teilchen bewegen sich weiter zufällig, aber die Bewegungen in beide Richtungen gleichen sich aus."
]
];

let qi=0;
let score=0;
let answered=false;

function quiz(){

  if(qi>=questions.length){
    $("quiz").innerHTML=`
      <h3>Ergebnis: ${score} von ${questions.length}</h3>
      <p>
      ${score===5
        ?"Sehr gut – alle Fragen richtig!"
        :score>=3
        ?"Gute Grundlage. Wiederhole die Stationen zu deinen Fehlern."
        :"Gehe die Lernstationen noch einmal durch und probiere es erneut."}
      </p>
      <button class="action primary" id="retry">
        Quiz wiederholen
      </button>
    `;

    $("retry").onclick=()=>{
      qi=0;
      score=0;
      answered=false;
      quiz();
    };
    return;
  }

  const q=questions[qi];

  $("quiz").innerHTML=`
    <div class="muted">
      Frage ${qi+1} / ${questions.length}
      · Richtige Antworten: ${score}
    </div>

    <h3>${q[0]}</h3>

    ${q[1].map((a,i)=>`
      <button class="answer" data-i="${i}">
        ${String.fromCharCode(65+i)}. ${a}
      </button>
    `).join("")}

    <p id="feedback"></p>

    <button class="action primary" id="qnext" disabled>
      ${qi===questions.length-1
        ?"Ergebnis anzeigen"
        :"Nächste Frage →"}
    </button>
  `;

  document.querySelectorAll(".answer").forEach(b=>{
    b.onclick=()=>{
      if(answered)return;
      answered=true;

      const ok=Number(b.dataset.i)===q[2];
      if(ok)score++;

      document.querySelectorAll(".answer").forEach(x=>{
        x.disabled=true;
        if(Number(x.dataset.i)===q[2]){
          x.classList.add("correct");
        }
      });

      if(!ok)b.classList.add("wrong");

      $("feedback").textContent=
        (ok?"Richtig! ":"Nicht ganz. ")+q[3];

      $("qnext").disabled=false;
    };
  });

  $("qnext").onclick=()=>{
    qi++;
    answered=false;
    quiz();
  };
}

render();
quiz();
</script>
</body>
</html>
